# Supabase (get from: https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# EIA API (get from: https://www.eia.gov/opendata/)
EIA_API_KEY=your-eia-key-here

# FRED API (get from: https://research.stlouisfed.org/useraccount/apikeys)
FRED_API_KEY=your-fred-key-here

# Groq API (get from: https://console.groq.com)
GROQ_API_KEY=your-groq-key-here

# OilPriceAPI (get from: https://www.oilpriceapi.com — optional, for WCS data)
OILPRICE_API_KEY=your-oilprice-key-here
